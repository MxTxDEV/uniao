generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  VENDEDOR
}

enum PaymentMethod {
  PIX
  DINHEIRO
  DEBITO
  CREDITO
  OUTRO
}

enum SaleStatus {
  COMPLETED
  CANCELED
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

// Loja (tenant). Todo dado de negócio pertence a um Tenant.
model Tenant {
  id               String   @id @default(cuid())
  name             String
  logoUrl          String?
  address          String?
  phone            String?
  instagram        String?
  allowDiscount    Boolean  @default(true)
  allowCustomItems Boolean  @default(true)
  allowCancel      Boolean  @default(true)
  // Contador sequencial das vendas (#000123). Incrementado atomicamente na transação da venda.
  saleCounter      Int      @default(0)
  createdAt        DateTime @default(now())

  users         User[]
  products      Product[]
  sales         Sale[]
  cashRegisters CashRegister[]
  auditLogs     AuditLog[]
  stockEntries  StockEntry[]
  expenses      Expense[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VENDEDOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sales  Sale[] @relation("SaleSeller")

  @@index([tenantId])
}

// Cadastro opcional: existe apenas para agilizar a venda (sem estoque/custo).
model Product {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  category  String
  price     Decimal  @db.Decimal(12, 2)
  sku       String?
  imageUrl  String?
  active    Boolean  @default(true)
  // Quantidade em estoque: sobe nas entradas de estoque e desce nas vendas (pode ficar negativa; nunca bloqueia a venda).
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items      SaleItem[]
  stockItems StockEntryItem[]

  @@index([tenantId, active])
}

// Vendas nunca são apagadas: cancelamento apenas muda o status (auditoria).
model Sale {
  id              String        @id @default(cuid())
  tenantId        String
  number          Int
  sellerId        String
  createdById     String
  cashRegisterId  String?
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  status          SaleStatus    @default(COMPLETED)
  // Chave de idempotência enviada pelo PDV: evita venda duplicada por duplo clique/retry.
  requestId       String?
  createdAt       DateTime      @default(now())
  canceledAt      DateTime?
  canceledById    String?
  cancelReason    String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  seller       User          @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  items        SaleItem[]

  @@unique([tenantId, number])
  @@unique([tenantId, requestId])
  @@index([tenantId, createdAt])
  @@index([tenantId, sellerId, createdAt])
  @@index([cashRegisterId])
}

model SaleItem {
  id          String  @id @default(cuid())
  tenantId    String
  saleId      String
  // NULL = venda avulsa (item sem produto cadastrado)
  productId   String?
  description String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  total       Decimal @db.Decimal(12, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([saleId])
}

model CashRegister {
  id             String             @id @default(cuid())
  tenantId       String
  status         CashRegisterStatus @default(OPEN)
  openedAt       DateTime           @default(now())
  openedById     String
  openingAmount  Decimal            @default(0) @db.Decimal(12, 2)
  closedAt       DateTime?
  closedById     String?
  expectedAmount Decimal?           @db.Decimal(12, 2)
  countedAmount  Decimal?           @db.Decimal(12, 2)
  difference     Decimal?           @db.Decimal(12, 2)
  notes          String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sales     Sale[]
  movements CashMovement[]

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
}

model CashMovement {
  id             String           @id @default(cuid())
  tenantId       String
  cashRegisterId String
  type           CashMovementType
  amount         Decimal          @db.Decimal(12, 2)
  description    String
  createdById    String
  createdAt      DateTime         @default(now())

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([cashRegisterId])
}

// Log de ações críticas (login, venda, cancelamento, caixa, usuários, configurações).
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}

// Entrada de estoque: soma a quantidade dos produtos e gera uma despesa com o valor total.
model StockEntry {
  id          String   @id @default(cuid())
  tenantId    String
  totalCost   Decimal  @db.Decimal(12, 2)
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items   StockEntryItem[]
  expense Expense?

  @@index([tenantId, createdAt])
}

model StockEntryItem {
  id           String @id @default(cuid())
  tenantId     String
  stockEntryId String
  productId    String
  quantity     Int

  stockEntry StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([stockEntryId])
  @@index([tenantId])
}

model Expense {
  id           String   @id @default(cuid())
  tenantId     String
  description  String
  amount       Decimal  @db.Decimal(12, 2)
  stockEntryId String?  @unique
  createdById  String
  createdAt    DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stockEntry StockEntry? @relation(fields: [stockEntryId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
}
