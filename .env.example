# PostgreSQL (Neon). Use a string "pooled" no DATABASE_URL e a "direct" no DIRECT_URL.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/uniao?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/uniao?sslmode=require"

# Segredo para assinar a sessão (mín. 32 caracteres). Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-32+-caracteres"
